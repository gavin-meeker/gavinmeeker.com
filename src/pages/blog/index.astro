---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import AppWindow from '../../components/office/AppWindow.astro';
import Sheet from '../../components/office/Sheet.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'Writing';
const description = 'Notes on building software, and the parts that were harder than they looked.';

// Header on row 2, then one row per post.
const FIRST_ROW = 3;
const ROWS = Math.max(24, FIRST_ROW + posts.length + 4);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<AppWindow
			app="excel"
			fileName="writing.xlsx"
			status={`${posts.length} records`}
		>

			<Fragment slot="subbar">
				<div class="flex items-center gap-2 border-b border-line bg-surface px-2 py-1.5">
					<span
						class="min-w-[4.5rem] rounded-sm border border-line px-1.5 py-0.5 font-mono text-[0.72rem]"
					>
						A2
					</span>
					<span class="px-1 font-mono text-[0.72rem] text-muted italic">fx</span>
					<span
						class="flex-1 truncate rounded-sm border border-line px-1.5 py-0.5 font-mono text-[0.72rem]"
					>
						=SORT(Posts[Title], Posts[Published], -1)
					</span>
				</div>
			</Fragment>

			<Sheet cols={8} rows={ROWS} minWidth="52rem">
				<!-- Header row -->
				<div
					class="app-word cell-head flex items-center px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style="grid-column: 1 / 3; grid-row: 2;"
				>
					Title
				</div>
				<div
					class="app-word cell-head flex items-center px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style="grid-column: 3 / 7; grid-row: 2;"
				>
					Description
				</div>
				<div
					class="app-word cell-head flex items-center justify-end px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style="grid-column: 7 / 8; grid-row: 2;"
				>
					Published
				</div>

				{
					posts.map((post, i) => (
						<>
							<a
								href={`/blog/${post.id}/`}
								class="app-word cell flex items-center truncate px-2 text-sm text-app underline underline-offset-2 hover:bg-app/5"
								style={`grid-column: 1 / 3; grid-row: ${FIRST_ROW + i};`}
							>
								{post.data.title}
							</a>
							<div
								class="cell flex items-center truncate px-2 text-[0.78rem] text-muted"
								style={`grid-column: 3 / 7; grid-row: ${FIRST_ROW + i};`}
							>
								{post.data.description}
							</div>
							<div
								class="cell flex items-center justify-end px-2 font-mono text-[0.72rem] text-muted"
								style={`grid-column: 7 / 8; grid-row: ${FIRST_ROW + i};`}
							>
								{fmt(post.data.pubDate)}
							</div>
						</>
					))
				}

				<div
					class="cell flex items-center px-2 font-mono text-[0.7rem] text-muted"
					style={`grid-column: 1 / 5; grid-row: ${FIRST_ROW + posts.length + 1};`}
				>
					=COUNTA(A{FIRST_ROW}:A{FIRST_ROW + posts.length - 1}) &rarr; {posts.length}
				</div>
			</Sheet>
		</AppWindow>
	</body>
</html>
