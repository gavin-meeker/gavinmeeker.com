---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import AppWindow from '../components/office/AppWindow.astro';
import Icon from '../components/office/Icon.astro';
import Sheet from '../components/office/Sheet.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' });

// Excel's own HYPERLINK() is how links are actually written in a cell, so the
// formula doubles as the link text rather than being decoration.
const contacts = [
	{
		label: 'GitHub',
		icon: 'github' as const,
		href: 'https://github.com/gavin-meeker',
		shown: 'github.com/gavin-meeker',
	},
	{
		label: 'Email',
		icon: 'mail' as const,
		href: 'mailto:gmeeker99@gmail.com',
		shown: 'gmeeker99@gmail.com',
	},
];

// Row bookkeeping, so everything shifts together as content grows.
// Name occupies rows 2–5, tagline 7–8, then contacts, then the tables.
const CONTACT_FIRST = 9;
const PROJ_HEAD = CONTACT_FIRST + contacts.length + 1;
const PROJ_FIRST = PROJ_HEAD + 1;
const WRITE_HEAD = PROJ_FIRST + projects.length + 1;
const WRITE_FIRST = WRITE_HEAD + 1;
const TOTAL_ROW = WRITE_FIRST + posts.length + 1;

const ROWS = TOTAL_ROW + 2;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<AppWindow
			app="excel"
			fileName="gavinmeeker.xlsx"
			status="Ready"
		>

			<Fragment slot="subbar">
				<div class="flex items-center gap-2 border-b border-line bg-surface px-2 py-1.5">
					<span
						class="min-w-[4.5rem] rounded-sm border border-line px-1.5 py-0.5 font-mono text-[0.72rem]"
					>
						A2
					</span>
					<span class="px-1 font-mono text-[0.72rem] text-muted italic">fx</span>
					<span
						class="flex-1 truncate rounded-sm border border-line px-1.5 py-0.5 font-mono text-[0.72rem]"
					>
						=CONCAT("Gavin"," ","Meeker")
					</span>
				</div>
			</Fragment>

			<Sheet cols={8} rows={ROWS} activeCols={[1, 4]} activeRows={[2, 5]}>
				<!-- Name: a merged, selected cell -->
				<div
					class="cell-selected handle relative flex items-center px-2"
					style="grid-column: 1 / 5; grid-row: 2 / 6;"
				>
					<h1
						class="m-0 text-[clamp(1.9rem,4.4vw,3.4rem)] leading-none font-bold tracking-[-0.035em] text-ink"
					>
						Gavin Meeker
					</h1>
				</div>

				<div
					class="cell flex items-center px-2 text-sm leading-snug text-muted"
					style="grid-column: 1 / 7; grid-row: 7 / 9;"
				>
				Software engineer. Turning complex financial logic into reliable, full-stack software
				</div>

				<!-- Contact, below the name. Kept in the left-hand columns: the
				     sheet scrolls horizontally on a phone, so anything past
				     column D is invisible without sideways scrolling. -->
				{
					contacts.map((c, i) => (
						<a
							href={c.href}
							class="cell grid no-underline hover:bg-app/5"
							style={`grid-column: 1 / 6; grid-row: ${CONTACT_FIRST + i}; grid-template-columns: repeat(5, minmax(0,1fr));`}
						>
							<span
								class="flex h-full items-center gap-2.5 px-2 text-base text-ink"
								style="grid-column: 1 / 3;"
							>
								<Icon name={c.icon} class="size-4 text-app" />
								{c.label}
							</span>
							<span
								class="flex h-full items-center truncate border-l border-line px-2 font-mono text-[0.85rem] text-app underline underline-offset-2"
								style="grid-column: 3 / 6;"
							>
								{/* The formula wrapper is the joke, but it costs ~13 characters
								    that a phone does not have. Shown only where it fits. */}
								<span class="hidden wide:inline">=HYPERLINK("</span>
								{c.shown}
								<span class="hidden wide:inline">")</span>
							</span>
						</a>
					))
				}

				<!-- Projects table -->
				<div
					class="app-powerpoint cell-head flex items-center px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style={`grid-column: 1 / 3; grid-row: ${PROJ_HEAD};`}
				>
					Project
				</div>
				<div
					class="app-powerpoint cell-head flex items-center px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style={`grid-column: 3 / 7; grid-row: ${PROJ_HEAD};`}
				>
					Stack
				</div>
				<div
					class="app-powerpoint cell-head flex items-center justify-end px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style={`grid-column: 7 / 8; grid-row: ${PROJ_HEAD};`}
				>
					Year
				</div>

				{
					projects.map((p, i) => (
						<a
							href="/projects"
							class="app-powerpoint cell grid no-underline hover:bg-app/5"
							style={`grid-column: 1 / 8; grid-row: ${PROJ_FIRST + i}; grid-template-columns: repeat(7, minmax(0,1fr));`}
						>
							<span
								class="flex h-full items-center truncate px-2 text-sm text-app underline underline-offset-2"
								style="grid-column: 1 / 3;"
							>
								{p.data.title}
							</span>
							<span
								class="flex h-full items-center truncate border-l border-line px-2 text-[0.78rem] text-muted"
								style="grid-column: 3 / 7;"
							>
								{p.data.tags.join(', ')}
							</span>
							<span
								class="flex h-full items-center justify-end border-l border-line px-2 font-mono text-[0.72rem] text-ink"
								style="grid-column: 7 / 8;"
							>
								{p.data.year}
							</span>
						</a>
					))
				}

				<!-- Writing table -->
				<div
					class="app-word cell-head flex items-center px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style={`grid-column: 1 / 3; grid-row: ${WRITE_HEAD};`}
				>
					Recent writing
				</div>
				<div
					class="app-word cell-head flex items-center px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style={`grid-column: 3 / 7; grid-row: ${WRITE_HEAD};`}
				>
					Description
				</div>
				<div
					class="app-word cell-head flex items-center justify-end px-2 font-mono text-[0.75rem] font-medium tracking-[0.14em] uppercase"
					style={`grid-column: 7 / 8; grid-row: ${WRITE_HEAD};`}
				>
					Published
				</div>

				{
					posts.map((post, i) => (
						<a
							href={`/blog/${post.id}/`}
							class="app-word cell grid no-underline hover:bg-app/5"
							style={`grid-column: 1 / 8; grid-row: ${WRITE_FIRST + i}; grid-template-columns: repeat(7, minmax(0,1fr));`}
						>
							<span
								class="flex h-full items-center truncate px-2 text-sm text-app underline underline-offset-2"
								style="grid-column: 1 / 3;"
							>
								{post.data.title}
							</span>
							<span
								class="flex h-full items-center truncate border-l border-line px-2 text-[0.78rem] text-muted"
								style="grid-column: 3 / 7;"
							>
								{post.data.description}
							</span>
							<span
								class="flex h-full items-center justify-end border-l border-line px-2 font-mono text-[0.72rem] text-muted"
								style="grid-column: 7 / 8;"
							>
								{fmt(post.data.pubDate)}
							</span>
						</a>
					))
				}

				<div
					class="cell flex items-center px-2 font-mono text-[0.7rem] text-muted"
					style={`grid-column: 1 / 6; grid-row: ${TOTAL_ROW};`}
				>
					=COUNTA() &rarr; {posts.length} posts, {projects.length} projects
				</div>

			</Sheet>
		</AppWindow>
	</body>
</html>
