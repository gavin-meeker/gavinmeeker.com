---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import AppWindow from '../components/office/AppWindow.astro';
import Slide from '../components/office/Slide.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order || b.data.year.localeCompare(a.data.year),
);

const title = 'Projects';
const description = 'Selected work — things I have designed, built, and shipped.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<AppWindow
			app="powerpoint"
			fileName="projects.pptx"
			status={`Slide 1 of ${projects.length} · English (US)`}
		>

			<Fragment slot="subbar">
				<div
					class="flex items-center gap-3 border-b border-line bg-surface px-3 py-1.5 font-mono text-[0.68rem] text-muted"
				>
					<span>Normal View</span>
					<span class="text-line">|</span>
					<span>{projects.length} slides</span>
					<span class="ml-auto hidden wide:inline">Zoom 100%</span>
				</div>
			</Fragment>

			<!--
			  Fills the window: the rail and canvas are flex children with min-h-0 so
			  the canvas scrolls internally instead of leaving dead space below the
			  last slide.
			-->
			<div class="flex min-h-0 flex-1 bg-canvas">
				<!-- Slide thumbnail rail -->
				<!--
				  The nav stretches full height so its right border runs the whole
				  column; the inner list is what sticks, and scrolls internally
				  once there are more thumbnails than fit the viewport.
				-->
				<nav
					aria-label="Slides"
					class="hidden w-52 shrink-0 border-r border-line bg-head wide:block"
				>
					<div class="sticky top-0 flex max-h-dvh flex-col gap-3 overflow-y-auto p-3">
					{
						projects.map((p, i) => (
							<a href={`#slide-${i + 1}`} class="group flex gap-2 no-underline">
								<span class="pt-1 font-mono text-[0.66rem] text-muted">{i + 1}</span>
								<span class="flex aspect-video flex-1 flex-col justify-center overflow-hidden border border-line bg-surface px-2 transition-colors group-hover:border-app">
									<span class="truncate text-[0.62rem] leading-tight font-semibold text-ink">
										{p.data.title}
									</span>
									<span class="mt-0.5 h-px w-6 bg-app" />
								</span>
							</a>
						))
					}
					</div>
				</nav>

				<!-- Slide canvas -->
				<div class="flex min-h-0 flex-1 flex-col items-center gap-8 overflow-y-auto p-4 wide:gap-12 wide:p-8">
					{projects.map((project, i) => (
						<Slide project={project} index={i} total={projects.length} />
					))}
				</div>
			</div>
		</AppWindow>
	</body>
</html>
