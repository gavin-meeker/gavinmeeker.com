---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AppWindow from '../components/office/AppWindow.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// Rough word count for the status bar, the way Word reports one.
const words = description.split(/\s+/).filter(Boolean).length;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<AppWindow
			app="word"
			fileName={`${slug}.docx`}
			status={`Page 1 of 1 · ~${words} words`}
		>

			<!-- Ruler -->
			<Fragment slot="subbar">
				<div class="border-b border-line bg-head px-2 py-1">
					<div class="mx-auto max-w-[52rem]">
						<div class="ruler h-3 rounded-xs border border-line bg-surface"></div>
					</div>
				</div>
			</Fragment>

			<!-- Document page -->
			<div class="bg-canvas px-3 py-6 wide:px-6 wide:py-10">
				<article
					class="doc mx-auto max-w-[52rem] animate-rise border border-line bg-surface px-6 py-10 font-doc text-[1.05rem] leading-[1.75] shadow-page wide:px-16 wide:py-14"
				>
					{
						heroImage && (
							<Image
								src={heroImage}
								alt=""
								width={1020}
								class="mb-8 block w-full border border-line"
							/>
						)
					}

					<p class="m-0 font-sans text-[0.7rem] tracking-widest text-muted uppercase">
						<FormattedDate date={pubDate} />
						{updatedDate && <span> · Revised <FormattedDate date={updatedDate} /></span>}
					</p>

					<h1 class="mt-3 mb-8 font-sans text-[2.1rem] leading-tight font-bold text-word">
						{title}
					</h1>

					<slot />
				</article>
			</div>
		</AppWindow>
	</body>
</html>
