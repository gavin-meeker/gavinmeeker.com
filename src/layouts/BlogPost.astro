---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AppWindow from '../components/office/AppWindow.astro';
import RibbonButton from '../components/office/RibbonButton.astro';
import RibbonGroup from '../components/office/RibbonGroup.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// Rough word count for the status bar, the way Word reports one.
const words = description.split(/\s+/).filter(Boolean).length;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<AppWindow
			app="word"
			fileName={`${slug}.docx`}
			tabs={['Home', 'Insert', 'Draw', 'Design', 'Layout', 'References', 'Review', 'View']}
			status={`Page 1 of 1 · ~${words} words`}
		>
			<Fragment slot="ribbon">
				<RibbonGroup label="Clipboard">
					<RibbonButton variant="tall" icon="📋">Paste</RibbonButton>
				</RibbonGroup>

				<RibbonGroup label="Font">
					<div class="flex flex-col gap-1">
						<div class="flex gap-1">
							<RibbonButton variant="select" wide>Newsreader</RibbonButton>
							<RibbonButton variant="select">12</RibbonButton>
						</div>
						<div class="flex gap-1">
							<RibbonButton style="bold">B</RibbonButton>
							<RibbonButton style="italic">I</RibbonButton>
							<RibbonButton style="underline">U</RibbonButton>
							<RibbonButton>A▾</RibbonButton>
						</div>
					</div>
				</RibbonGroup>

				<RibbonGroup label="Paragraph">
					<div class="flex flex-col gap-1">
						<div class="flex gap-1">
							<RibbonButton>≔</RibbonButton>
							<RibbonButton>≡</RibbonButton>
							<RibbonButton>≣</RibbonButton>
						</div>
						<div class="flex gap-1">
							<RibbonButton>Line spacing</RibbonButton>
						</div>
					</div>
				</RibbonGroup>

				<RibbonGroup label="Styles" last>
					<div class="flex gap-1">
						<span
							class="inline-flex h-11 w-16 flex-col items-center justify-center rounded-sm border border-line bg-surface text-[0.6rem] leading-tight"
						>
							<span class="text-[0.8rem] font-semibold text-word">AaBb</span>
							<span class="text-muted">Heading</span>
						</span>
						<span
							class="inline-flex h-11 w-16 flex-col items-center justify-center rounded-sm border border-line bg-surface text-[0.6rem] leading-tight"
						>
							<span class="font-doc text-[0.8rem]">AaBb</span>
							<span class="text-muted">Normal</span>
						</span>
					</div>
				</RibbonGroup>
			</Fragment>

			<!-- Ruler -->
			<Fragment slot="subbar">
				<div class="border-b border-line bg-head px-2 py-1">
					<div class="mx-auto max-w-[52rem]">
						<div class="ruler h-3 rounded-xs border border-line bg-surface"></div>
					</div>
				</div>
			</Fragment>

			<!-- Document page -->
			<div class="bg-canvas px-3 py-6 wide:px-6 wide:py-10">
				<article
					class="doc mx-auto max-w-[52rem] animate-rise border border-line bg-surface px-6 py-10 font-doc text-[1.05rem] leading-[1.75] shadow-page wide:px-16 wide:py-14"
				>
					{
						heroImage && (
							<Image
								src={heroImage}
								alt=""
								width={1020}
								class="mb-8 block w-full border border-line"
							/>
						)
					}

					<p class="m-0 font-sans text-[0.7rem] tracking-widest text-muted uppercase">
						<FormattedDate date={pubDate} />
						{updatedDate && <span> · Revised <FormattedDate date={updatedDate} /></span>}
					</p>

					<h1 class="mt-3 mb-8 font-sans text-[2.1rem] leading-tight font-bold text-word">
						{title}
					</h1>

					<slot />
				</article>
			</div>
		</AppWindow>
	</body>
</html>
