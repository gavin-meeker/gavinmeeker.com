---
/*
  The shared office-application frame.

  Deliberately minimal: a title bar, an optional sub-bar (formula bar / ruler),
  the body, and a status bar carrying the site navigation. There is no ribbon.

  The rule is that nothing here should look interactive unless it is. A ribbon
  full of Paste / B / I / U buttons reproduces Excel faithfully but makes ~20
  promises the page can't keep, and it carries almost no identifying signal —
  the grid, the A/B/C headers, the cell references and the sheet tabs are what
  actually say "spreadsheet". Reference the app; don't emulate it.

  Each page picks an `app`, which retints the whole frame via `--color-app`.
*/
import StatusBar from './StatusBar.astro';

type App = 'excel' | 'word' | 'powerpoint';

interface Props {
	app: App;
	fileName: string;
	/** Right-hand text in the status bar, e.g. a word count or slide count. */
	status?: string;
}

const { app, fileName, status = 'Ready' } = Astro.props;

const appClass = { excel: 'app-excel', word: 'app-word', powerpoint: 'app-powerpoint' }[app];
const appName = { excel: 'Excel', word: 'Word', powerpoint: 'PowerPoint' }[app];
---

<div class:list={[appClass, 'flex min-h-dvh w-full flex-col bg-surface']}>
	<!-- Title bar -->
	<div class="flex items-center gap-3 bg-app px-4 py-2 text-white">
		<span class="truncate font-mono text-xs tracking-wide">{fileName}</span>
		<span class="ml-auto hidden text-xs opacity-70 wide:block">{appName}</span>
	</div>

	<!-- Formula bar / ruler / toolbar -->
	<slot name="subbar" />

	<!--
	  Document area. `min-h-0` lets this flex child actually shrink, which is
	  what allows the sheet inside to scroll rather than pushing the status
	  bar off screen.
	-->
	<div class="flex min-h-0 flex-1 flex-col">
		<slot />
	</div>

	<StatusBar status={status} />
</div>
