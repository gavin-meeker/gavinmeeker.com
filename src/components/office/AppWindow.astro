---
/*
  The shared office-application frame: title bar, ribbon tab strip, ribbon,
  an optional sub-bar (formula bar / ruler / slide toolbar), the body, and a
  status bar carrying the site navigation.

  Each page picks an `app`, which retints the whole frame via `--color-app`.
*/
import StatusBar from './StatusBar.astro';

type App = 'excel' | 'word' | 'powerpoint';

interface Props {
	app: App;
	fileName: string;
	/** Ribbon tabs. The first is rendered as the green/blue/orange File button. */
	tabs?: string[];
	activeTab?: string;
	/** Right-hand text in the status bar, e.g. a word count or slide count. */
	status?: string;
}

const {
	app,
	fileName,
	tabs = ['Home', 'Insert', 'Draw', 'Design', 'Layout', 'Review', 'View'],
	activeTab = 'Home',
	status = 'Ready',
} = Astro.props;

const appClass = { excel: 'app-excel', word: 'app-word', powerpoint: 'app-powerpoint' }[app];
const appName = { excel: 'Excel', word: 'Word', powerpoint: 'PowerPoint' }[app];
---

<div
	class:list={[
		appClass,
		'flex min-h-dvh w-full flex-col bg-surface',
	]}
>
	<!-- Title bar -->
	<div class="flex items-center gap-3 bg-app px-3 py-2 text-white">
		<span class="flex gap-1.5" aria-hidden="true">
			<i class="block size-2.5 rounded-full bg-white/45"></i>
			<i class="block size-2.5 rounded-full bg-white/45"></i>
			<i class="block size-2.5 rounded-full bg-white/45"></i>
		</span>
		<span class="truncate font-mono text-xs tracking-wide">{fileName}</span>
		<span class="ml-auto hidden text-xs opacity-80 wide:block">{appName}</span>
	</div>

	<!-- Ribbon tab strip -->
	<div class="flex items-stretch gap-0.5 overflow-x-auto border-b border-line bg-surface px-2 pt-2">
		<span
			class="shrink-0 rounded-t-sm bg-app px-2.5 py-1.5 text-xs font-semibold text-white select-none"
		>
			File
		</span>
		{
			tabs.map((tab) => (
				<span
					class:list={[
						'shrink-0 border-b-2 px-2.5 py-1.5 text-xs whitespace-nowrap select-none',
						tab === activeTab
							? 'border-app font-semibold text-app'
							: 'border-transparent text-muted',
					]}
				>
					{tab}
				</span>
			))
		}
	</div>

	<!-- Ribbon -->
	<div class="flex items-stretch overflow-x-auto border-b border-line bg-chrome px-1.5 pt-2 pb-1">
		<slot name="ribbon" />
	</div>

	<!-- Formula bar / ruler / toolbar -->
	<slot name="subbar" />

	<!-- Document area -->
	<div class="flex-1">
		<slot />
	</div>

	<StatusBar status={status} />
</div>
