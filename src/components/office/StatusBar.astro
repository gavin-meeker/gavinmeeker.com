---
/*
  Status bar. This is the site's primary navigation — the sheet tabs along the
  bottom of the window, where a spreadsheet keeps them.
*/
interface Props {
	status?: string;
}

const { status = 'Ready' } = Astro.props;

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);

const tabs = [
	{ label: 'Home', href: '/' },
	{ label: 'Projects', href: '/projects' },
	{ label: 'Writing', href: '/blog' },
	{ label: 'About', href: '/about' },
];

const year = new Date().getFullYear();
---

<!--
  Sticky: this bar carries the site navigation, and a long sheet would
  otherwise push it far below the fold. The upward shadow lifts it off the
  content so it reads as chrome rather than as the end of the page.
-->
<div
	class="sticky bottom-0 z-20 flex items-center gap-1 border-t border-frame bg-head px-2 py-1.5 shadow-[0_-4px_12px_rgb(31_35_40/8%)]"
>
	<!-- Tab navigation arrows: signals "this is a tab strip", as in Excel. -->
	<span
		aria-hidden="true"
		class="hidden shrink-0 items-center gap-1 pr-1.5 font-mono text-[0.7rem] text-muted/70 wide:flex"
	>
		<span>◀</span>
		<span>▶</span>
	</span>

	<nav aria-label="Sheets" class="flex min-w-0 items-end gap-0.5 overflow-x-auto">
		{
			tabs.map(({ label, href }) => {
				const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
				return (
					<a
						href={href}
						aria-current={isActive ? 'page' : undefined}
						class:list={[
							'group relative shrink-0 rounded-t-sm border px-3.5 py-1.5 text-[0.8rem] whitespace-nowrap no-underline transition-all',
							isActive
								? 'border-line border-t-2 border-t-app bg-surface font-semibold text-app'
								: 'border-transparent bg-surface/50 text-muted hover:-translate-y-px hover:border-line hover:bg-surface hover:text-app',
						]}
					>
						{label}
					</a>
				);
			})
		}

		<!-- New-sheet affordance, decorative. -->
		<span
			aria-hidden="true"
			class="ml-1 hidden shrink-0 items-center px-1.5 py-1.5 font-mono text-sm text-muted/70 wide:inline-flex"
		>
			⊕
		</span>
	</nav>

	<span class="flex-1"></span>

	<span class="hidden shrink-0 font-mono text-[0.62rem] tracking-widest text-muted wide:inline">
		&copy; {year} Gavin Meeker
	</span>
	<span
		class="ml-3 shrink-0 border-l border-line pl-3 font-mono text-[0.62rem] tracking-widest text-muted uppercase"
	>
		{status}
	</span>
</div>
