---
/*
  Inline SVG icons. Kept as paths rather than an icon library so they ship as
  markup with no runtime and no extra request. `currentColor` means they
  inherit the cell's text color, including its hover state.
*/
interface Props {
	name: 'github' | 'mail' | 'rss' | 'link';
	class?: string;
}

const { name, class: className } = Astro.props;

const icons: Record<Props['name'], string[]> = {
	github: [
		'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z',
	],
	mail: [
		'M1.5 3h13A1.5 1.5 0 0 1 16 4.5v7a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 11.5v-7A1.5 1.5 0 0 1 1.5 3zm.44 1.5 5.6 4.2a.75.75 0 0 0 .92 0l5.6-4.2H1.94zM14.5 6.06l-4.98 3.74a2.25 2.25 0 0 1-2.7 0L1.5 6.06v5.44h13V6.06z',
	],
	rss: [
		'M2.5 11a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM1 6.5a.75.75 0 0 1 .75-.75A8.5 8.5 0 0 1 10.25 14a.75.75 0 0 1-1.5 0A7 7 0 0 0 1.75 7.25.75.75 0 0 1 1 6.5zM1 2.25A.75.75 0 0 1 1.75 1.5 12.75 12.75 0 0 1 14.5 14.25a.75.75 0 0 1-1.5 0A11.25 11.25 0 0 0 1.75 3 .75.75 0 0 1 1 2.25z',
	],
	// The conventional chain-link glyph: two interlocking halves.
	link: [
		'M6.354 5.5H4a3 3 0 0 0 0 6h3a3 3 0 0 0 2.83-4H8.9a2 2 0 0 1-1.9 3H4a2 2 0 1 1 0-4h1.535c.218-.376.495-.714.82-1z',
		'M9 5.5a3 3 0 0 0-2.83 4h1.098A2 2 0 0 1 9 6.5h3a2 2 0 1 1 0 4h-1.535a4.02 4.02 0 0 1-.82 1H12a3 3 0 1 0 0-6H9z',
	],
};
---

<svg
	viewBox="0 0 16 16"
	width="14"
	height="14"
	aria-hidden="true"
	class:list={['shrink-0', className]}
>
	{icons[name].map((d) => <path fill="currentColor" d={d} />)}
</svg>
